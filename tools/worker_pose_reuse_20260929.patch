+def suspension_sample_pose(params, position, yaw, pitch=0.0, roll=0.0):
+	"""Build geometry for one unchanged pre-solve pose, never terrain results.
+
+	The caller must rebuild after any translation, attitude or descriptor
+	change. No native query, contact band, support memory or solver step is
+	skipped. Offsets also retain Y, which the sampling and plane-fit adapters
+	previously recomputed independently.
+	"""
+	x, unused_y, z = map(float, position)
+	sine, cosine = math.sin(float(yaw)), math.cos(float(yaw))
+	rotation = _suspension_rotation(pitch, roll)
+	spring_offsets = tuple(_suspension_point_offset(point, rotation)
+		for point in params['springs'])
+	pseudo_offsets = tuple(_suspension_point_offset(point, rotation)
+		for point in params.get('pseudo_contacts', ()))
+	def world_points(offsets):
+		return tuple((x + cosine * ox + sine * oz,
+			z - sine * ox + cosine * oz) for ox, unused_oy, oz in offsets)
+	return {'spring_offsets': spring_offsets, 'pseudo_offsets': pseudo_offsets,
+		'spring_points': world_points(spring_offsets),
+		'pseudo_points': world_points(pseudo_offsets)}
+
